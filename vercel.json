{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bun scripts/build-vercel.ts",
  "outputDirectory": "vercel-dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/app",
      "has": [
        {
          "type": "host",
          "value": "(bots\\.everestqai\\.com|eqbots\\.vercel\\.app)"
        }
      ],
      "destination": "https://eqbot.everestqai.com/app",
      "permanent": false
    },
    {
      "source": "/guides/install-openbot-vps",
      "destination": "/guides/install-cat-vps",
      "permanent": true
    },
    {
      "source": "/guides/openbot-101",
      "destination": "/guides/cat-101",
      "permanent": true
    },
    {
      "source": "/guides/openbot-marketplace",
      "destination": "/guides/cat-marketplace",
      "permanent": true
    },
    {
      "source": "/guides/openbot-hosted-servers",
      "destination": "/guides/cat-hosted-servers",
      "permanent": true
    },
    {
      "source": "/guides/wtf-is-openbot",
      "destination": "/guides/wtf-is-cat",
      "permanent": true
    },
    {
      "source": "/news/introducing-openbot",
      "destination": "/news/introducing-cat",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/download/:platform/latest",
      "destination": "https://eqbots-account.artisticmap.workers.dev/download/:platform/latest"
    },
    {
      "source": "/api/browser/:path*",
      "destination": "https://eqbots-account.artisticmap.workers.dev/api/browser/:path*"
    },
    {
      "source": "/plugins",
      "destination": "/marketplace/apps/index.html"
    }
  ]
}
