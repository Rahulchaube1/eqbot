{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bun scripts/build-vercel.ts",
  "outputDirectory": "vercel-dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/download/windows/latest",
      "destination": "https://github.com/Rahulchaube1/eqbot/releases/download/eqbots-windows-v0.70.0/EQBots-0.70.0-x64.exe",
      "permanent": false
    },
    {
      "source": "/app",
      "has": [{ "type": "host", "value": "(bots\\.everestqai\\.com|eqbots\\.vercel\\.app)" }],
      "destination": "https://eqbot.everestqai.com/app",
      "permanent": false
    },
    {
      "source": "/download/:platform(macos|windows|linux|ios|android)/latest",
      "destination": "https://github.com/Rahulchaube1/eqbot/releases",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/browser/:path*",
      "destination": "https://eqbots-account.artisticmap.workers.dev/api/browser/:path*"
    },
    {
      "source": "/plugins",
      "destination": "/marketplace/apps/index.html"
    }
  ]
}
