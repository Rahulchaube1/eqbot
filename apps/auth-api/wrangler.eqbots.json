{
  "name": "eqbots-account",
  "account_id": "9fad5c8ed3ce7fe2500840df945bf98d",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "main": "dist/server/index.js",
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"]
    }
  ],
  "assets": {
    "directory": "dist/client"
  },
  "no_bundle": true,
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "AUTH_EXPOSE_DEVELOPMENT_CODE": "false",
    "SITE_PUBLISH_ENABLED": "false",
    "GOOGLE_OAUTH_ORIGIN": "https://eqbot.everestqai.com"
  },
  "ratelimits": [
    {
      "name": "MARKETPLACE_INGRESS_RATE_LIMITER",
      "namespace_id": "2026082701",
      "simple": {
        "limit": 300,
        "period": 60
      }
    },
    {
      "name": "MARKETPLACE_MUTATION_RATE_LIMITER",
      "namespace_id": "2026082702",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "MARKETPLACE_UPLOAD_RATE_LIMITER",
      "namespace_id": "2026082703",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "SITE_REPORT_RATE_LIMITER",
      "namespace_id": "2026083101",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "GITHUB_TOKEN_RATE_LIMITER",
      "namespace_id": "2026092911",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "LIVE_ACTIVITY_RATE_LIMITER",
      "namespace_id": "2026092901",
      "simple": {
        "limit": 300,
        "period": 60
      }
    },
    {
      "name": "FEEDBACK_RATE_LIMITER",
      "namespace_id": "2026110801",
      "simple": {
        "limit": 3,
        "period": 60
      }
    }
  ],
  "d1_databases": [
    {
      "database_name": "eqbots-auth",
      "binding": "DB",
      "migrations_dir": "migrations",
      "database_id": "00e85a07-b5bc-40bd-8164-499235c91275"
    }
  ],
  "r2_buckets": [
    {
      "binding": "AVATARS",
      "bucket_name": "eqbots-avatars"
    },
    {
      "binding": "SKILLS",
      "bucket_name": "eqbots-skills"
    },
    {
      "binding": "SITES",
      "bucket_name": "eqbots-sites"
    }
  ]
}
